PORT=8000

# Database Configuration
USE_SQLITE=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=320511@Mysql
DB_NAME=mavericks
DB_SSL_CA_PATH=

# JWT Authentication (Access + Refresh Tokens)
JWT_ACCESS_SECRET=finplanai-access-secret-key-2024-secure-long-random-string-for-jwt-signing
JWT_REFRESH_SECRET=finplanai-refresh-secret-key-2024-secure-long-random-string-for-jwt-refresh
ACCESS_TOKEN_EXPIRES_IN=900s         # 15 minutes
REFRESH_TOKEN_EXPIRES_IN=7d          # 7 days

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

# CORS Origin
FRONTEND_ORIGIN=http://localhost:3000

# Cookie Settings
COOKIE_SECURE=false                  # true in production with HTTPS
COOKIE_SAMESITE=Lax